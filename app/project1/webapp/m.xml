_schema-version: 3.3.0
ID: vehicleinspection
description: A simple CAP project.
version: 1.0.0
modules:
  - name: vehicleinspection-srv
    type: nodejs
    path: gen/srv
    requires:
      - name: vehicleinspection-auth
      - name: vehicleinspection-db
      - name: vehicleinspection-connectivity
      - name: vehicleinspection-destination-service
      - name: vehicleinspection-cloud-logging
      - name: vehicleinspection-autoscaler
      - name: vehicleinspection-credstore
      - name: vehicleinspectionscheduler
    provides:
      - name: srv-api
        properties:
          srv-url: ${default-url}
    parameters:
      buildpack: nodejs_buildpack
      instances: 1
      readiness-health-check-http-endpoint: /health
      readiness-health-check-type: http
    build-parameters:
      builder: npm
  - name: vehicleinspection-db-deployer
    type: hdb
    path: gen/db
    requires:
      - name: vischema_ups
      - name: vehicleinspection-db
    parameters:
      buildpack: nodejs_buildpack
  - name: vehicleinspection-app-content
    type: com.sap.application.content
    path: .
    requires:
      - name: vehicleinspection-repo-host
        parameters:
          content-target: true
    build-parameters:
      build-result: resources
      requires:
        - artifacts:
            - vehicleinspection.zip
          name: vehicleinspection
          target-path: resources/
        - artifacts:
            - adnocvivehicleinspection.zip
          name: adnocvivehicleinspection
          target-path: resources/
  - name: vehicleinspection
    type: html5
    path: app/vehicleinspection
    build-parameters:
      build-result: dist
      builder: custom
      commands:
        - npm install
        - npm run build:cf
      supported-platforms:
        []
  - name: vehicleinspection-destination-content
    type: com.sap.application.content
    requires:
      - name: vehicleinspection-destination-service
        parameters:
          content-target: true
      - name: vehicleinspection-repo-host
        parameters:
          service-key:
            name: vehicleinspection-repo-host-key
      - name: vehicleinspection-auth
        parameters:
          service-key:
            name: vehicleinspection-auth-key
    parameters:
      content:
        instance:
          destinations:
            - Name: vehicleinspection_html5_repo_host
              ServiceInstanceName: vehicleinspection-html5-service
              ServiceKeyName: vehicleinspection-repo-host-key
              sap.cloud.service: vehicleinspection
            - Authentication: OAuth2UserTokenExchange
              Name: vehicleinspection_auth
              ServiceInstanceName: vehicleinspection-auth
              ServiceKeyName: vehicleinspection-auth-key
              sap.cloud.service: vehicleinspection
          existing_destinations_policy: ignore
    build-parameters:
      no-source: true
  - name: adnocvivehicleinspection
    type: html5
    path: app/vehicleinspection
    build-parameters:
      build-result: dist
      builder: custom
      commands:
        - npm install
        - npm run build:cf
      supported-platforms:
        []
resources:
  - name: vischema_ups
    type: org.cloudfoundry.existing-service
    parameters:
      service-name: vischema_ups
  - name: vehicleinspection-auth
    type: org.cloudfoundry.managed-service
    parameters:
      config:
        tenant-mode: dedicated
        xsappname: vehicleinspection
      path: ./xs-security.json
      service: xsuaa
      service-plan: application
  - name: vehicleinspectionscheduler
    type: org.cloudfoundry.managed-service
    parameters:
      service: jobscheduler
      service-name: vehicleinspectionscheduler
      service-plan: standard
      config:
        enable-xsuaa-support: true
  - name: vehicleinspection-db
    type: com.sap.xs.hdi-container
    parameters:
      service: hana
      service-plan: hdi-shared
  - name: vehicleinspection-connectivity
    type: org.cloudfoundry.managed-service
    parameters:
      service: connectivity
      service-plan: lite
  - name: vehicleinspection-autoscaler
    type: org.cloudfoundry.managed-service
    parameters:
      path: ./autoscaler.json
      service: autoscaler
      service-key:
        name: vehicleinspection-auth-key
      service-plan: standard
  - name: vehicleinspection-credstore
    type: org.cloudfoundry.existing-service
    parameters:
      service-key:
        name: cl_credstore-key
      service-name: ADD_CredStore
  - name: vehicleinspection-repo-host
    type: org.cloudfoundry.managed-service
    parameters:
      service: html5-apps-repo
      service-name: vehicleinspection-html5-service
      service-plan: app-host
  - name: vehicleinspection-destination-service
    type: org.cloudfoundry.managed-service
    parameters:
      config:
        HTML5Runtime_enabled: true
        init_data:
          instance:
            destinations:
              - Authentication: NoAuthentication
                HTML5.DynamicDestination: true
                HTML5.ForwardAuthToken: true
                Name: vehicleinspection-srv-api
                ProxyType: Internet
                Type: HTTP
                URL: ~{srv-api/srv-url}
              - Authentication: NoAuthentication
                Name: ui5
                ProxyType: Internet
                Type: HTTP
                URL: https://ui5.sap.com
            existing_destinations_policy: update
        version: 1.0.0
      service: destination
      service-name: vehicleinspection-destination-service
      service-plan: lite
    requires:
      - name: srv-api
  - name: vehicleinspection-cloud-logging
    type: org.cloudfoundry.managed-service
    parameters:
      service: cloud-logging
      service-plan: dev
      config:
        ingest_otlp:
          enabled: true
parameters:
  deploy_mode: html5-repo
  enable-parallel-deployments: true
build-parameters:
  before-all:
    - builder: custom
      commands:
        - npm ci
        - npx cds build --production
