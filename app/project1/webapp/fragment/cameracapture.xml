<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:commons="sap.suite.ui.commons"
    xmlns:card="sap.f.cards">
    <Dialog id="cameraDialogNew" title="{i18n>fragment_CameraCaptureCapturePhoto}" contentWidth="70%" contentHeight="100%" class="sapUiContentPadding" >
        <customHeader>
            <Toolbar>
                <card:Header title="{i18n>fragment_CameraCaptureCapturePhoto}" />
                <ToolbarSpacer/>
                <Button icon="sap-icon://decline" type="Reject" press="onCloseCameraDialog"/>
            </Toolbar>
        </customHeader>
        <VBox class="sapUiSmallMargin">
            <!-- Live Camera Preview -->
            <core:HTML id="videoContainerCamera" content="&lt;video id='cameraStream' autoplay playsinline width='100%' height='50%' style='border: 1px solid #ccc;'&gt;&lt;/video&gt;" />
        </VBox>

        <footer>
            <OverflowToolbar id="cameraFooter">
                <ToolbarSpacer />
                <Button id="btnTakePhotoVisual" text="{i18n>fragment_CameraCaptureCapture}" press="onTakePhoto" type="Emphasized"/>
                <Button text="{i18n>fragment_CameraCaptureSwitch}" type="Emphasized" icon="sap-icon://journey-change" press="onSwitchCamera" class="sapUiTinyMarginBegin"/>
            </OverflowToolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>